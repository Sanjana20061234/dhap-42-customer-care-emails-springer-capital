# Airflow Image and Execution
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.11
AIRFLOW_UID=50000

# Airflow Webserver Admin Credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me

# Airflow Metadata Database (PostgreSQL)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# Airflow Webserver Secret Key
AIRFLOW_WEBSERVER_SECRET_KEY=change_me

# MinIO Configuration
MINIO_ROOT_USER=minioadmin42
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=customer-care-emails
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
